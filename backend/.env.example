DATABASE_URL=postgresql://applyit:applyit@postgres:5432/applyit
API_HOST=0.0.0.0
API_PORT=8080
HOST_API_PORT=8080
# Generate a long random value before exposing the API outside localhost.
API_TOKEN=
FEED_LIMIT=200

# First version keeps the user's current role intent, with token-aware matching.
WATCH_KEYWORDS=software engineer,frontend,front-end,front end,backend,full stack,full-stack,fullstack,product engineer,design engineer,web developer,mobile engineer,android developer,ios engineer,data engineer,machine learning engineer,ml engineer,infrastructure engineer,platform engineer,devops engineer,site reliability engineer
WATCH_EXCLUDES=intern,internship

SCANNER_IDLE_SECONDS=2
SOURCE_LEASE_SECONDS=1800
COUNT_COLLAPSE_RATIO=0.20
COUNT_COLLAPSE_MIN_PRIOR=25
DEFAULT_SCAN_INTERVAL_SECONDS=3600

# ntfy is optional. If set, `bootstrap` creates a private delivery endpoint.
# Prefer a self-hosted/authenticated ntfy server. Topics on ntfy.sh are public.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NOTIFIER_IDLE_SECONDS=5
NOTIFIER_MAX_ATTEMPTS=8

ATS_REQUEST_TIMEOUT_SECONDS=45
# Hard cap for one source, including provider fetch and database reconciliation.
SOURCE_SCAN_TIMEOUT_SECONDS=1200
WORKDAY_MAX_FETCH_SECONDS=900
REGISTRY_MANIFEST_URL=https://storage.stapply.ai/jobhive/v1/manifest.json
