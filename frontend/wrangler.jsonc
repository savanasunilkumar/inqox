{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inqox-web",
  "account_id": "36be7c1a54d196cbf30e4b923fb82fb8",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "inqox.com",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "inqox-web"
    },
    {
      "binding": "APPLICATION_AGENT",
      "service": "applyit-application-agent",
      "entrypoint": "Frontend"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "JOBS_API_BASE_URL": "https://applyit-jobs-api-iyx36e4y3q-uc.a.run.app"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
