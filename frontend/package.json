{
  "name": "inqox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev:profile": "INQOX_PROFILE_PREVIEW=1 next dev --hostname 127.0.0.1 --port 3001"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.5",
    "@opennextjs/cloudflare": "^1.20.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "pngjs": "^7.0.0",
    "radix-ui": "^1.6.7",
    "react": "~19.2.3",
    "react-day-picker": "^10.0.1",
    "react-dom": "~19.2.3",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.137.0"
  }
}
