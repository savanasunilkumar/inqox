# Origin of the existing ApplyIt ingestion API. No trailing path is needed.
JOBS_API_BASE_URL=http://127.0.0.1:8080

# Optional. Use the same value as API_TOKEN in the ingestion API.
JOBS_API_TOKEN=

# Clerk: use the inqox Development instance for the private test preview.
# Add actual values to .env.local; keep the variable names unchanged.

# Clerk keys live in Cloudflare. The UI loads only the public key from /api/auth/config.
